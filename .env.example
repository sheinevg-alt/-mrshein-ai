# Public Mini App URL — set this to the exact Vercel URL of the deployed project.
NEXT_PUBLIC_APP_URL=https://YOUR-V3-PROJECT.vercel.app

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Private admin access. Use a long random value known only to the owner.
MRSHEIN_ADMIN_SECRET=

# Supabase server-side connection. NEVER expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Runway Developer API — server-side only.
RUNWAYML_API_SECRET=

# Public web checkout (disabled until Tochka internet acquiring is connected)
NEXT_PUBLIC_RUBLE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://example.com
TOCHKA_JWT=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_TAX_SYSTEM_CODE=usn_income
# Set explicitly to the actual fiscal VAT mode: none, vat0, vat5, vat7, vat10, vat22, vat105, vat107, vat110, vat122
TOCHKA_VAT_TYPE=
